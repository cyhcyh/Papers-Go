TZ=Asia/Shanghai
REQUIRE_INVITE_CODE=false
# Empty: generate a secret once and save it in the local data volume.
JWT_SECRET=
LLM_TIMEOUT=120
# 精读：0 根据模型选择预算；未知云端模型默认32K，可填写其实际上下文容量（tokens）。
READING_CONTEXT_TOKENS=0
# 精读与深读共享并发额度，可在后台模型配置调整。
READING_CLOUD_CONCURRENCY=2
READING_LOCAL_CONCURRENCY=1
CLASSIFY_CLOUD_CONCURRENCY=4
# 可选初始连接地址。Ollama 连接和模型请在管理后台配置。
OLLAMA_BASE_URL=http://ollama:11434
# 仅用于 docker-compose.ollama.yml 的宿主机端口，默认只允许本机访问。
OLLAMA_BIND=127.0.0.1
OLLAMA_PORT=11434
EMBEDDING_DIM=1024
GITHUB_TOKEN=
# 云端论文速读默认4并发，后台模型配置可调整；本地模型保持串行。
BRIEF_CLOUD_CONCURRENCY=4
# 作者影响力：空值使用 OpenAlex 匿名额度；请求额度不足时后台任务保留进度。
OPENALEX_API_KEY=
AUTHOR_IMPACT_BATCH_SIZE=100
AUTHOR_IMPACT_SECONDS=120
# 预警任务分批处理，单次到时保留进度，后续定时或手动任务继续。
ALERT_BATCH_SIZE=500
ALERT_SECONDS=30
TELEGRAM_BOT_TOKEN=
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV,cs.MA,cs.NE,cs.RO,stat.ML,math.CO
# 首次启动试运行上限；日常完整增量同步不受此项限制。
FETCH_LIMIT=400
CONFERENCE_SOURCES=ICML.2026,AAAI.2026,NeurIPS.2026,ICLR.2026
SCHEDULER_ENABLED=true
BOOTSTRAP_ENABLED=true
# SQLite 文件映射范围最多 1GB；按需读取，不预留或承诺占用 1GB 物理内存。0 可关闭。
SQLITE_MMAP_MB=1024

EMBEDDING_CLOUD_CONCURRENCY=4
EMBEDDING_LOCAL_CONCURRENCY=1
